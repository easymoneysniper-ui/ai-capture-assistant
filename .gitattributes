# 统一换行符，避免 Windows 提交后 Linux/macOS 检出时出现整文件 diff
* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则 cmd 解析可能出问题
*.bat text eol=crlf
*.cmd text eol=crlf

# PowerShell 脚本保持 CRLF（Windows 原生）
*.ps1 text eol=crlf

# 二进制资源不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.gz binary
*.zip binary
*.wasm binary
